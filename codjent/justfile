# Run this module's unit tests
test:
    go test -race ./...

# Run go vet for this module
vet:
    go vet ./...

# Build this module's packages
build:
    go build ./...

# Run codjent's local backend with the embedded frontend
run:
    go run ./cmd/codjent

# Run the backend for frontend development (use pnpm dev for the UI)
dev:
    go run ./cmd/codjent --no-frontend

# Build the static frontend that is embedded in the binary
frontend:
    cd frontend && pnpm build

# Build the frontend and verify the committed export is current
frontend-check:
    #!/usr/bin/env bash
    set -euo pipefail
    cd frontend
    NEXT_TELEMETRY_DISABLED=1 pnpm build
    cd ..
    if [ -n "$(git status --porcelain -- frontend/out)" ]; then
        echo "[ERROR] codjent/frontend/out is stale. Run 'just frontend' and commit the export."
        git status --short -- frontend/out
        exit 1
    fi
    echo "Embedded frontend export is current."

# Build the frontend and run codjent with the embedded UI
web: frontend
    go run ./cmd/codjent --workspace ..

# Run static analysis for this module
lint:
    golangci-lint run ./...

# Tidy this module's go.mod and go.sum
tidy:
    go mod tidy

# Check that this module's go.mod and go.sum are tidy
tidy-check:
    go mod tidy -diff
