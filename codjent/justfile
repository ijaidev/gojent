# Run this module's unit tests
test:
    go test -race ./...

# Run codjent's local backend with the embedded frontend
run:
    go run ./cmd/codjent

# Run the backend for frontend development (use pnpm dev for the UI)
dev:
    go run ./cmd/codjent --no-frontend

# Build the static frontend that is embedded in the binary
frontend:
    cd frontend && pnpm build

# Build the frontend and run codjent with the embedded UI
web: frontend
    go run ./cmd/codjent --workspace ..

# Run static analysis for this module
lint:
    golangci-lint run ./...

# Tidy this module's go.mod and go.sum
tidy:
    go mod tidy

# Check that this module's go.mod and go.sum are tidy
tidy-check:
    go mod tidy -diff
