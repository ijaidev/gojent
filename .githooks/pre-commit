#!/usr/bin/env bash
set -e

# Include common user binary directories in PATH (for git GUI clients and non-login shells)
export PATH="$HOME/.cargo/bin:$HOME/go/bin:$HOME/.local/bin:$PATH"

if ! command -v just >/dev/null 2>&1; then
    echo "[ERROR] 'just' command runner is required for pre-commit hooks."
    echo "Please install just (e.g. 'sudo apt install just' or 'cargo install just')."
    exit 1
fi

echo "[pre-commit] Running verification checks via 'just check'..."

just check

echo "[pre-commit] All checks passed successfully."
