#!/usr/bin/env bash
set -e

echo "[pre-commit] Running verification checks..."

# 1. Check formatting
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
    echo "[ERROR] The following files are not formatted:"
    echo "$unformatted"
    echo ""
    echo "Please run 'just fmt' or 'go fmt ./...' to format your code before committing."
    exit 1
fi
echo "[OK] Formatting check passed."

# 2. Run linter
if ! golangci-lint run ./...; then
    echo ""
    echo "[ERROR] Linting issues detected. Commit aborted."
    echo "Please run 'just lint' or 'golangci-lint run ./...' to fix the issues."
    exit 1
fi
echo "[OK] Linting check passed."

# 3. Run unit tests
if ! go test ./...; then
    echo ""
    echo "[ERROR] Unit tests failed. Commit aborted."
    echo "Please run 'just test' or 'go test -v ./...' to inspect failures."
    exit 1
fi
echo "[OK] Unit tests passed."

echo "[pre-commit] All checks passed successfully."
